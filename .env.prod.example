# =====================================================================
# Capacity Connect - Production Environment Secrets Template
# Instructions: Copy this file to .env.prod on your server and populate.
# =====================================================================

# 1. Database Strong Credentials
POSTGRES_PASSWORD=replace_with_strong_random_database_password_32_chars

# 2. Cryptographic Secrets (Generate using: openssl rand -hex 32)
JWT_SECRET=replace_with_64_char_hex_secret_for_jwt_session_signing
CERT_HMAC_SECRET=replace_with_64_char_hex_secret_for_certificate_signatures

# 3. Domain & Public Hostname
DOMAIN=capacityconnect.moes.gov.in

# 4. Optional LLM API Key (for automated MCQ generation from PDFs)
LLM_API_KEY=
